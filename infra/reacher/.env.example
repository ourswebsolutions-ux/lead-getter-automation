REACHER_PORT=8080
# Long random string; also paste it into the app: Settings → Integrations → Reacher secret
REACHER_SECRET=
# A mailbox on a domain you control (used in MAIL FROM during SMTP checks)
REACHER_FROM_EMAIL=verify@yourdomain.com
# Hostname used in HELO/EHLO; should resolve to this server and have matching reverse DNS (PTR)
REACHER_HELLO_NAME=mail.yourdomain.com
