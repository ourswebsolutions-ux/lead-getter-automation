# Copy to .env and fill in. Never commit the real .env or the data/ directory.
PORT=8787
HOST=0.0.0.0
# At least 32 random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# First admin account (created on first start if it does not exist). Password: 12+ characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Free trial length per device (days)
TRIAL_DAYS=2
# Where new subscription requests are emailed (defaults to ADMIN_EMAIL)
ADMIN_NOTIFY_EMAIL=
# SMTP — used to email subscription requests to you and license keys to customers
# (smtp://user:pass@host:587 or smtps://user:pass@host:465)
SMTP_URL=
MAIL_FROM=Lead Getter Enterprise <licenses@example.com>
# Set to 1 when running behind a reverse proxy (nginx/Caddy) so client IPs are correct
TRUST_PROXY=0
# DATA_DIR=/var/lib/lge-license
