    "cheerio": "^1.2.0",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "groq-sdk": "^1.6.0",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.3",
    "nodemailer": "^10.5.0",
    "openai": "^7.55.0",
    "papaparse": "^5.7.1",
    "pino": "^10.4.0",
    "playwright-core": "^1.64.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
