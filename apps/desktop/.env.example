# Copy to .env (git-ignored). These values are baked into the app at build time.
# Gmail: create an App Password (Google Account → Security → App passwords); encode @ as %40.
SUBSCRIPTION_SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com:465
# Where activation OTPs are emailed
SUBSCRIPTION_OTP_EMAIL=you@gmail.com
# Long random string (e.g. `openssl rand -hex 32`). Never change it after you start activating customers.
SUBSCRIPTION_SECRET=
